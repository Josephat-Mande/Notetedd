{
  "expo": {
    "name": "Notetedd",
    "slug": "Notetedd",
    "version": "1.0.0",
    "orientation": "portrait",
    "assetBundlePatterns": ["**/*"],
    "icon": "./icon.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notetedd.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.notetedd.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./favicon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./splash-icon.jpg",
          "imageWidth": 200,
          "width": 1024,
          "height": 800,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cb848cbe-cd58-4190-b349-851f3bffb3ca",
        "GOOGLE_API_KEY": "process.env.GOOGLE_API_KEY"
      }
    },
    "owner": "mande"
  }
}
