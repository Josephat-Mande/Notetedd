{
  "expo": {
    "name": "Notetedd",
    "slug": "Notetedd",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./public/favicon.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notetedd.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./public/icon.jpeg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.notetedd.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icon.jpeg"
    },
    "plugins": [
      "expo-router",
      
      [
        "expo-splash-screen",
        {
          "image": "./public/icon.jpeg",
          "imageWidth": 200,
          "width": 1024,
          "height": 800,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "startUrl": "/",
          "scope": "/"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cb848cbe-cd58-4190-b349-851f3bffb3ca",
        "GOOGLE_API_KEY": "process.env.GOOGLE_API_KEY"
      }
    },
    "owner": "mande"
  }
}
